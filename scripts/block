#!/bin/sh
set -eu
action="$(basename "$0")"
if [ "$#" -ne 1 ]; then
    echo "Usage: /$action <lowercase-block-slug>" >&2
    exit 1
fi
case "$action" in
    create-block) exec php /usr/local/lib/wordpress-dev/blocks.php create "$1" ;;
    build-block) task=build ;;
    watch-block) task=start ;;
    *) echo "Unknown block helper: $action" >&2; exit 1 ;;
esac
directory="$(php /usr/local/lib/wordpress-dev/blocks.php locate "$1")"
exec npm --prefix "$directory" run "$task"
